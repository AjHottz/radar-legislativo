{
  "name": "Monitorar Radar Legislativo e notificar Telegram",
  "description": "Executa o pipeline diario (ETL + IA Gemini) do Radar Legislativo via runner Python local, consulta proposicoes criticas no Supabase e envia alertas e resumo semanal Top 5 no Telegram.",
  "active": false,
  "nodes": [
    {
      "id": "0c067893-fccd-471d-ba7a-115ac2b8ba80",
      "name": "Agendar pipeline diario 06h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        240,
        220
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 6,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "9296e2e6-9d98-4daf-9b8e-67056c2809f7",
      "name": "Executar pipeline Python (8085)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        520,
        220
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8085/run-pipeline",
        "authentication": "none",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "{\"step\": \"all\", \"days\": 2, \"limit\": 20}",
        "options": {
          "timeout": 300000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "d62794b0-19ab-4a86-bb82-d2a76c940c34",
      "name": "Consultar proposicoes criticas 24h",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        800,
        220
      ],
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "SELECT id_proposicao\n  , sigla_tipo\n  , numero\n  , ano\n  , tema_ia\n  , similaridade_tema\n  , COALESCE(resumo_executivo, ementa) AS resumo_executivo\n  , data_apresentacao\n  , uri\nFROM public.fato_proposicoes\nWHERE tema_ia IN (\n    'Tecnologia, Dados e Inteligência Artificial'\n    , 'Sistema Tributário e Fiscal'\n    , 'Economia, Mercado Financeiro e Regulação'\n  )\n  AND resumo_executivo IS NOT NULL\n  AND processado_ia_em >= NOW() - INTERVAL '24 hours'\nORDER BY similaridade_tema DESC\nLIMIT 10;"
      },
      "executeOnce": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "postgres": {
          "id": "CONFIGURE_POSTGRES_CREDENTIAL",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "9dc1025e-aa80-4997-8774-ba5942a4edfb",
      "name": "Agregar alertas criticos",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        1080,
        220
      ],
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "proposicoes",
        "include": "allFields"
      }
    },
    {
      "id": "43423c9a-ae7b-408c-9c83-dce811f533de",
      "name": "Enviar alerta diario Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1360,
        220
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "SEU_TELEGRAM_CHAT_ID",
        "text": "=<b>Radar Legislativo: Alerta Diario (Temas Criticos)</b>\n<i>{{ $now.setZone('America/Sao_Paulo').toFormat('dd/MM/yyyy HH:mm') }}</i>\n\n{{ $('Agregar alertas criticos').item.json.proposicoes.map((p, idx) => (idx + 1) + '. <b>' + p.sigla_tipo + ' ' + p.numero + '/' + p.ano + '</b> [' + p.tema_ia + ']\\nSimilaridade: ' + Number(p.similaridade_tema || 0).toFixed(3) + '\\nResumo: ' + String(p.resumo_executivo || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').slice(0, 220) + '...' + (p.uri ? '\\n<a href=\"' + p.uri + '\">Ver proposicao</a>' : '')).join('\\n\\n') }}",
        "additionalFields": {
          "appendAttribution": false,
          "disable_web_page_preview": true,
          "parse_mode": "HTML"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "telegramApi": {
          "id": "CONFIGURE_TELEGRAM_CREDENTIAL",
          "name": "Telegram account"
        }
      }
    },
    {
      "id": "94f3c78f-7d01-431f-a3c6-b75c99b7205f",
      "name": "Agendar resumo semanal Seg 08h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        240,
        540
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 8,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "f6ac9ee2-0336-4a93-ac9d-2c9bfe1e2497",
      "name": "Consultar Top 5 semanal (7d)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        520,
        540
      ],
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "SELECT id_proposicao\n  , sigla_tipo\n  , numero\n  , ano\n  , tema_ia\n  , similaridade_tema\n  , COALESCE(resumo_executivo, ementa) AS resumo_executivo\n  , data_apresentacao\n  , uri\nFROM public.fato_proposicoes\nWHERE tema_ia IS NOT NULL\n  AND resumo_executivo IS NOT NULL\n  AND data_apresentacao >= NOW() - INTERVAL '7 days'\nORDER BY similaridade_tema DESC NULLS LAST\nLIMIT 5;"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "postgres": {
          "id": "CONFIGURE_POSTGRES_CREDENTIAL",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "8b80eb04-e478-4daf-ac5a-65a018ff2aab",
      "name": "Agregar Top 5 semanal",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        800,
        540
      ],
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "top5",
        "include": "allFields"
      }
    },
    {
      "id": "4f81f3a4-7061-4bf6-bf8d-8aeb1cf85fef",
      "name": "Enviar resumo semanal Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1080,
        540
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "SEU_TELEGRAM_CHAT_ID",
        "text": "=<b>Radar Legislativo: Resumo Semanal Top 5</b>\n<i>{{ $now.setZone('America/Sao_Paulo').toFormat('dd/MM/yyyy') }}</i>\n\n{{ $('Agregar Top 5 semanal').item.json.top5.map((p, idx) => (idx + 1) + '. <b>' + p.sigla_tipo + ' ' + p.numero + '/' + p.ano + '</b> [' + p.tema_ia + ']\\nSimilaridade: ' + Number(p.similaridade_tema || 0).toFixed(3) + '\\nResumo: ' + String(p.resumo_executivo || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').slice(0, 220) + '...' + (p.uri ? '\\n<a href=\"' + p.uri + '\">Ver proposicao</a>' : '')).join('\\n\\n') }}",
        "additionalFields": {
          "appendAttribution": false,
          "disable_web_page_preview": true,
          "parse_mode": "HTML"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "telegramApi": {
          "id": "CONFIGURE_TELEGRAM_CREDENTIAL",
          "name": "Telegram account"
        }
      }
    },
    {
      "id": "dfdaa0eb-fa86-4533-b122-1887451aef5d",
      "name": "Sticky Note 1a8cad75",
